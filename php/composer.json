{
    "name": "flash-sale/api-php",
    "description": "The v1 reservation contract reimplemented in Laravel, to measure what the framework costs.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "lint": [
            "pint --test",
            "phpstan analyse --no-progress"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
