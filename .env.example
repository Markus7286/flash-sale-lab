POSTGRES_VERSION=16
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale
POSTGRES_PORT=5432

REDIS_VERSION=7
REDIS_PORT=6379

API_PORT=8080

# Pool size handed to the v1 baseline; see config.Config.DBMaxConns.
DB_MAX_CONNS=25
PER_USER_LIMIT=1

# Must outlast the longest sale; see config.Config.SaleKeyTTL.
SALE_KEY_TTL=24h

# v3 worker; see config.Config for what each one bounds.
STREAM_BATCH_SIZE=100
STREAM_CLAIM_IDLE=30s
STREAM_MAX_DELIVERIES=5
RECONCILE_INTERVAL=30s

# Applies to both binaries; debug is what makes a request_id traceable end to end.
LOG_LEVEL=info

# The worker's own /metrics listener. The api serves /metrics from API_PORT.
METRICS_ADDR=:8081
WORKER_METRICS_PORT=8081

PROMETHEUS_VERSION=v3.14.0
PROMETHEUS_PORT=9090
GRAFANA_VERSION=13.2.2
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
