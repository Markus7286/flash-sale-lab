    {
      "id": 1,
      "type": "stat",
      "title": "Reservations / sec",
      "description": "Successful reservations only; duplicates and sold-out replies are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "flash-sale-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "flash-sale-prom"
          },
          "editorMode": "code",
          "expr": "sum(rate(flash_sale_requests_total{result=\"reserved\"}[15s]))",
          "legendFormat": "reserved/s",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
